# backend/.env.local.example — copy to backend/.env for day-to-day local
# development against services started directly on your workstation (not
# Docker). This is identical to .env.example (that file already assumes
# bare-metal localhost by default); kept as a separate file only so the
# three profiles this guide references (.env, .env.production, .env.local)
# each have a concrete example on disk, matching how docs/LOCAL_DEPLOYMENT_GUIDE.md
# refers to them.
# exactly `backend/.env` (see .env.production.example / .env.local.example
# below for the two common profiles, and docs/LOCAL_DEPLOYMENT_GUIDE.md for
# when to use which).
#
# Every variable maps 1:1 to a field on Settings (app/core/config.py) via
# pydantic-settings' automatic UPPER_SNAKE_CASE env-var mapping.

# --- Service endpoints ---
# For Docker Compose: use the service names (postgres, chromadb, etc).
# For a bare-metal local install (no Docker): use localhost with the port
# each service actually listens on. Both "localhost" and "127.0.0.1" are
# in the on-prem host allowlist (core/config.py ALLOWED_HOST_PATTERNS), so
# neither triggers the air-gap boot-time refusal.
DATABASE_URL=postgresql://sovereign:sovereign@localhost:5432/sovereignai
CHROMA_URL=http://localhost:8000
MODEL_RUNTIME_URL=http://localhost:11434
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# CHANGE THIS before any real use — the default is a known, public value.
JWT_SECRET=CHANGE_ME_AT_DEPLOY_TIME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Sandbox code execution ---
# "none" = sandboxed containers get zero network access (the air-gap
# guarantee extends into code execution, not just model inference).
SANDBOX_NETWORK_MODE=none
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEM_LIMIT=512m
SANDBOX_TIMEOUT_SECONDS=30

# --- CORS ---
# JSON-array syntax (pydantic-settings parses List[str] fields as JSON).
# Must include whatever origin the frontend is actually served from.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
