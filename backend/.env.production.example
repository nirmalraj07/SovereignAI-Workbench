# backend/.env.production.example — copy to backend/.env on a production
# deployment. Differs from .env.example in: Docker service hostnames
# (assumes docker compose or Kubernetes, not bare-metal), a placeholder
# that FORCES you to generate a real secret (the app boots fine with the
# .env.example default, which is the problem — this one doesn't, on
# purpose, so production can't accidentally inherit a known secret).

DATABASE_URL=postgresql://sovereign:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/sovereignai
CHROMA_URL=http://chromadb:8000
MODEL_RUNTIME_URL=http://model-runtime:11434
REDIS_URL=redis://redis:6379/0

# Generate with: openssl rand -base64 48   (or PowerShell equivalent — see
# docs/LOCAL_DEPLOYMENT_GUIDE.md "Windows: generating a strong JWT secret")
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

SANDBOX_NETWORK_MODE=none
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEM_LIMIT=512m
SANDBOX_TIMEOUT_SECONDS=30

# Set to your real frontend origin — do not leave this as localhost in
# production, or the browser's CORS preflight will fail against the real
# deployed frontend URL.
CORS_ALLOW_ORIGINS=["https://sovereignai.yourcompany.internal"]
