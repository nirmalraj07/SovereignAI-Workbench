# frontend/.env.production — Next.js loads this automatically for `next
# build` and `next start` (this is a real Next.js convention, unlike the
# backend's single-.env-file limitation — see backend/.env.example).
# Copy to frontend/.env.production and fill in your real deployed origin.
NEXT_PUBLIC_API_BASE_URL=https://sovereignai.yourcompany.internal
NEXT_PUBLIC_WS_BASE_URL=wss://sovereignai.yourcompany.internal
